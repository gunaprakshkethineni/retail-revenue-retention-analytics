          {
            "name": "line_cost",
            "dataType": "double",
            "sourceColumn": "line_cost",
            "summarizeBy": "none"
          },
          {
            "name": "line_profit",
            "dataType": "double",
            "sourceColumn": "line_profit",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_order_items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_order_items.csv\"),[Delimiter=\",\", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted,{{\"order_item_id\", Int64.Type}, {\"order_id\", Int64.Type}, {\"product_id\", Int64.Type}, {\"quantity\", Int64.Type}, {\"unit_price\", type number}, {\"unit_cost\", type number}, {\"discount_pct\", type number}, {\"gross_amount\", type number}, {\"discount_amount\", type number}, {\"line_revenue\", type number}, {\"line_cost\", type number}, {\"line_profit\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "type": "calculatedTableColumn",
            "sourceColumn": "[Value]",
            "isNameInferred": true,
            "isHidden": true,
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "{ BLANK() }"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[line_revenue] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Total Cost",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[line_cost] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Total Profit",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[line_profit] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Profit Margin %",
            "expression": [
              "DIVIDE ( [Total Profit], [Total Revenue] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Total Transactions",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_order_items ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Total Orders",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_order_items[order_id] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Active Customers",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_orders[customer_id] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Avg Order Value",
            "expression": [
              "DIVIDE ( [Total Revenue], [Total Orders] )"
            ],
            "formatString": "\"€\"#,##0.00"
          },
          {
            "name": "Units Sold",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[quantity] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Revenue per Customer",
            "expression": [
              "DIVIDE ( [Total Revenue], [Active Customers] )"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Revenue PM",
            "expression": [
              "CALCULATE ( [Total Revenue], DATEADD ( dim_date[full_date], -1, MONTH ) )"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Revenue MoM %",
            "expression": [
              "DIVIDE ( [Total Revenue] - [Revenue PM], [Revenue PM] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Revenue PY",
            "expression": [
              "CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[full_date] ) )"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Revenue YoY %",
            "expression": [
              "DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Revenue YTD",
            "expression": [
              "TOTALYTD ( [Total Revenue], dim_date[full_date] )"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Revenue 3M Rolling Avg",
            "expression": [
              "DIVIDE (",
              "    CALCULATE (",
              "        [Total Revenue],",
              "        DATESINPERIOD ( dim_date[full_date], MAX ( dim_date[full_date] ), -3, MONTH )",
              "    ),",
              "    3",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Returned Revenue",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[line_revenue] ),",
              "    fact_orders[order_status] = \"Returned\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Cancelled Revenue",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[line_revenue] ),",
              "    fact_orders[order_status] = \"Cancelled\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Leaked Revenue",
            "expression": [
              "[Returned Revenue] + [Cancelled Revenue]"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Leakage Rate %",
            "expression": [
              "DIVIDE ( [Leaked Revenue], [Total Revenue] + [Leaked Revenue] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Discount Given",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[discount_amount] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Gross at List Price",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[gross_amount] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "\"€\"#,##0"
          },
          {
            "name": "Discount Rate %",
            "expression": [
              "DIVIDE ( [Discount Given], [Gross at List Price] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Cohort Size",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( dim_customers[customer_id] ),",
              "    ALLEXCEPT ( dim_customers, dim_customers[Cohort Month] )",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Retained Customers",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_orders[customer_id] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Retention %",
            "expression": [
              "DIVIDE ( [Retained Customers], [Cohort Size] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Repeat Customers",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( dim_customers[customer_id] ),",
              "    dim_customers[Customer Type] = \"Repeat buyer\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "One-Time Customers",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( dim_customers[customer_id] ),",
              "    dim_customers[Customer Type] = \"One-time buyer\"",
              ")"
            ],
            "formatString": "#,##0"
          },
          {
            "name": "Repeat Rate %",
            "expression": [
              "DIVIDE ( [Repeat Customers], [Repeat Customers] + [One-Time Customers] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Top 30% Revenue Share",
            "expression": [
              "VAR TopRevenue =",
              "    CALCULATE (",
              "        [Total Revenue],",
              "        ALLSELECTED ( dim_customers ),",
              "        dim_customers[Value Group] = \"Top 30%\"",
              "    )",
              "VAR AllRevenue =",
              "    CALCULATE ( [Total Revenue], ALLSELECTED ( dim_customers ) )",
              "RETURN",
              "    DIVIDE ( TopRevenue, AllRevenue )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Top 10% Revenue Share",
            "expression": [
              "VAR TopRevenue =",
              "    CALCULATE (",
              "        [Total Revenue],",
              "        ALLSELECTED ( dim_customers ),",
              "        dim_customers[Revenue Decile] = 1",
              "    )",
              "VAR AllRevenue =",
              "    CALCULATE ( [Total Revenue], ALLSELECTED ( dim_customers ) )",
              "RETURN",
              "    DIVIDE ( TopRevenue, AllRevenue )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Cumulative Revenue %",
            "expression": [
              "VAR CurrentDecile =",
              "    MAX ( dim_customers[Revenue Decile] )",
              "VAR CumulativeRevenue =",
              "    CALCULATE (",
              "        [Total Revenue],",
              "        ALLSELECTED ( dim_customers ),",
              "        dim_customers[Revenue Decile] <= CurrentDecile",
              "    )",
              "VAR AllRevenue =",
              "    CALCULATE ( [Total Revenue], ALLSELECTED ( dim_customers ) )",
              "RETURN",
              "    DIVIDE ( CumulativeRevenue, AllRevenue )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Pareto Page Title",
            "expression": [
              "\"Customer concentration: the top 30% generate \"",
              "    & FORMAT ( [Top 30% Revenue Share], \"0.0%\" )",
              "    & \" of revenue\""
            ]
          },
          {
            "name": "MoM Arrow",
            "expression": [
              "VAR Change = [Revenue MoM %]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Change ), \"\",",
              "        Change > 0, \"▲ \" & FORMAT ( Change, \"0.0%\" ),",
              "        Change < 0, \"▼ \" & FORMAT ( ABS ( Change ), \"0.0%\" ),",
              "        \"0.0%\"",
              "    )"
            ]
          },
          {
            "name": "Filter Context Footer",
            "expression": [
              "\"Showing \"",
              "    & FORMAT ( [Total Transactions], \"#,##0\" )",
              "    & \" transactions from \"",
              "    & FORMAT ( [Active Customers], \"#,##0\" )",
              "    & \" customers\""
            ]
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "0914a4df-68f5-4d07-aaf0-05f529d7882a",
        "fromTable": "fact_orders",
        "fromColumn": "order_date",
        "toTable": "dim_date",
        "toColumn": "full_date"
      },
      {
        "name": "4be0fffa-3698-4e75-908a-e8391cddb623",
        "fromTable": "fact_orders",
        "fromColumn": "customer_id",
        "toTable": "dim_customers",
        "toColumn": "customer_id"
      },
      {
        "name": "e6f713b2-3b3b-4a09-8600-5a70c1260e05",
        "fromTable": "fact_orders",
        "fromColumn": "store_id",
        "toTable": "dim_stores",
        "toColumn": "store_id"
      },
      {
        "name": "d7f00a57-121a-4656-b29b-32a9c1965d84",
        "fromTable": "fact_order_items",
        "fromColumn": "order_id",
        "toTable": "fact_orders",
        "toColumn": "order_id"
      },
      {
        "name": "a293c967-fc03-40e4-8a0a-39c4f42064cd",
        "fromTable": "fact_order_items",
        "fromColumn": "product_id",
        "toTable": "dim_products",
        "toColumn": "product_id"
      },
      {
        "name": "59936bf7-31ff-49dc-a804-d3587827dc50",
        "fromTable": "dim_products",
        "fromColumn": "category_id",
        "toTable": "dim_categories",
        "toColumn": "category_id"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"dim_date\", \"dim_customers\", \"dim_categories\", \"dim_products\", \"dim_stores\", \"fact_orders\", \"fact_order_items\", \"_Measures\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}