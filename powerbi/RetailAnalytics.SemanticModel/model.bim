                "    Typed = Table.TransformColumnTypes(Promoted,{{\"product_id\", Int64.Type}, {\"product_name\", type text}, {\"category_id\", Int64.Type}, {\"brand\", type text}, {\"unit_price\", type number}, {\"unit_cost\", type number}, {\"launch_date\", type date}})",
