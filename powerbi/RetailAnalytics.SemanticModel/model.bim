{
  "name": "RetailAnalytics",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": [
          "\"C:\\Users\\gunar\\projects\\retail-revenue-retention-analytics\\data_real\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ]
      }
    ],
    "tables": [
      {
        "name": "dim_date",
        "columns": [
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "full_date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "summarizeBy": "none"
          },
          {
            "name": "quarter",
            "dataType": "string",
            "sourceColumn": "quarter",
            "summarizeBy": "none"
          },
          {
            "name": "month_number",
            "dataType": "int64",
            "sourceColumn": "month_number",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none"
          },
          {
            "name": "week_of_year",
            "dataType": "int64",
            "sourceColumn": "week_of_year",
            "summarizeBy": "none"
          },
          {
            "name": "day_of_month",
            "dataType": "int64",
            "sourceColumn": "day_of_month",
            "summarizeBy": "none"
          },
          {
            "name": "day_name",
            "dataType": "string",
            "sourceColumn": "day_name",
            "summarizeBy": "none"
          },
          {
            "name": "is_weekend",
            "dataType": "int64",
            "sourceColumn": "is_weekend",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\dim_date.csv\"),[Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted,{{\"date_key\", Int64.Type}, {\"full_date\", type date}, {\"year\", Int64.Type}, {\"quarter\", type text}, {\"month_number\", Int64.Type}, {\"month_name\", type text}, {\"year_month\", type text}, {\"week_of_year\", Int64.Type}, {\"day_of_month\", Int64.Type}, {\"day_name\", type text}, {\"is_weekend\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "dim_customers",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "first_name",
            "dataType": "string",
            "sourceColumn": "first_name",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "last_name",
            "dataType": "string",
            "sourceColumn": "last_name",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "email",
            "dataType": "string",
            "sourceColumn": "email",
            "summarizeBy": "none"
          },
          {
            "name": "gender",
            "dataType": "string",
            "sourceColumn": "gender",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "birth_date",
            "dataType": "string",
            "sourceColumn": "birth_date",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "age_band",
            "dataType": "string",
            "sourceColumn": "age_band",
            "summarizeBy": "none"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "signup_date",
            "dataType": "dateTime",
            "sourceColumn": "signup_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "acquisition_channel",
            "dataType": "string",
            "sourceColumn": "acquisition_channel",
            "summarizeBy": "none"
          },
          {
            "name": "is_loyalty_member",
            "dataType": "int64",
            "sourceColumn": "is_loyalty_member",
            "summarizeBy": "none"
          },
          {
            "name": "First Order Date",
            "type": "calculated",
            "expression": [
              "CALCULATE (",
              "    MIN ( fact_orders[order_date] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Cohort Month",
            "type": "calculated",
            "expression": [
              "IF (",
              "    ISBLANK ( dim_customers[First Order Date] ),",
              "    \"No purchase\",",
              "    FORMAT ( dim_customers[First Order Date], \"YYYY-MM\" )",
              ")"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "Lifetime Orders",
            "type": "calculated",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( fact_orders[order_id] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "Lifetime Revenue",
            "type": "calculated",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_order_items[line_revenue] ),",
              "    fact_orders[order_status] = \"Completed\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "Recency Days",
            "type": "calculated",
            "expression": [
              "VAR LastOrder =",
              "    CALCULATE (",
              "        MAX ( fact_orders[order_date] ),",
              "        fact_orders[order_status] = \"Completed\"",
              "    )",
              "VAR DatasetEnd =",
              "    CALCULATE ( MAX ( fact_orders[order_date] ), ALL ( fact_orders ) )",
              "RETURN",
              "    IF ( NOT ISBLANK ( LastOrder ), DATEDIFF ( LastOrder, DatasetEnd, DAY ) )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Customer Type",
            "type": "calculated",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    dim_customers[Lifetime Orders] = 0, \"No purchase\",",
              "    dim_customers[Lifetime Orders] = 1, \"One-time buyer\",",
              "    \"Repeat buyer\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "Order Frequency Band",
            "type": "calculated",
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    dim_customers[Lifetime Orders] = 0, \"No purchase\",",
              "    dim_customers[Lifetime Orders] = 1, \"1 order\",",
              "    dim_customers[Lifetime Orders] = 2, \"2 orders\",",
              "    dim_customers[Lifetime Orders] <= 4, \"3-4 orders\",",
              "    dim_customers[Lifetime Orders] <= 9, \"5-9 orders\",",
              "    \"10+ orders\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "Value Group",
            "type": "calculated",
            "expression": [
              "VAR PayingCustomers =",
              "    FILTER ( ALL ( dim_customers ), dim_customers[Lifetime Revenue] > 0 )",
              "VAR TotalPaying =",
              "    COUNTROWS ( PayingCustomers )",
              "VAR MyRank =",
              "    RANKX ( PayingCustomers, dim_customers[Lifetime Revenue], , DESC )",
              "RETURN",
              "    IF (",
              "        dim_customers[Lifetime Revenue] > 0,",
              "        IF ( MyRank <= TotalPaying * 0.30, \"Top 30%\", \"Bottom 70%\" ),",
              "        \"No purchase\"",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "Revenue Decile",
            "type": "calculated",
            "expression": [
              "VAR PayingCustomers =",
              "    FILTER ( ALL ( dim_customers ), dim_customers[Lifetime Revenue] > 0 )",
              "VAR TotalPaying =",
              "    COUNTROWS ( PayingCustomers )",
              "VAR MyRank =",
              "    RANKX ( PayingCustomers, dim_customers[Lifetime Revenue], , DESC )",
              "RETURN",
              "    IF (",
              "        dim_customers[Lifetime Revenue] > 0,",
              "        ROUNDUP ( DIVIDE ( MyRank, TotalPaying ) * 10, 0 )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          },
          {
            "name": "R Score",
            "type": "calculated",
            "expression": [
              "VAR Buyers =",
              "    FILTER ( ALL ( dim_customers ), NOT ISBLANK ( dim_customers[Recency Days] ) )",
              "VAR TotalBuyers =",
              "    COUNTROWS ( Buyers )",
              "VAR MyRank =",
              "    RANKX ( Buyers, dim_customers[Recency Days], , ASC )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( dim_customers[Recency Days] ),",
              "        6 - ROUNDUP ( DIVIDE ( MyRank, TotalBuyers ) * 5, 0 )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "F Score",
            "type": "calculated",
            "expression": [
              "VAR Buyers =",
              "    FILTER ( ALL ( dim_customers ), dim_customers[Lifetime Orders] > 0 )",
              "VAR TotalBuyers =",
              "    COUNTROWS ( Buyers )",
              "VAR MyRank =",
              "    RANKX ( Buyers, dim_customers[Lifetime Orders], , DESC )",
              "RETURN",
              "    IF (",
              "        dim_customers[Lifetime Orders] > 0,",
              "        6 - ROUNDUP ( DIVIDE ( MyRank, TotalBuyers ) * 5, 0 )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "M Score",
            "type": "calculated",
            "expression": [
              "VAR Buyers =",
              "    FILTER ( ALL ( dim_customers ), dim_customers[Lifetime Revenue] > 0 )",
              "VAR TotalBuyers =",
              "    COUNTROWS ( Buyers )",
              "VAR MyRank =",
              "    RANKX ( Buyers, dim_customers[Lifetime Revenue], , DESC )",
              "RETURN",
              "    IF (",
              "        dim_customers[Lifetime Revenue] > 0,",
              "        6 - ROUNDUP ( DIVIDE ( MyRank, TotalBuyers ) * 5, 0 )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "RFM Segment",
            "type": "calculated",
            "expression": [
              "VAR R = dim_customers[R Score]",
              "VAR F = dim_customers[F Score]",
              "VAR M = dim_customers[M Score]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( R ), \"No purchase\",",
              "        R >= 4 && F >= 4 && M >= 4, \"Champions\",",
              "        R >= 3 && F >= 3,           \"Loyal Customers\",",
              "        R >= 4 && F <= 2,           \"New Customers\",",
              "        R = 3  && F <= 2,           \"Promising\",",
              "        R <= 2 && F >= 4 && M >= 4, \"At Risk - High Value\",",
              "        R <= 2 && F >= 3,           \"At Risk\",",
              "        R <= 2 && F <= 2 && M >= 3, \"Hibernating\",",
              "        \"Lost\"",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\dim_customers.csv\"),[Delimiter=\",\", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted,{{\"customer_id\", Int64.Type}, {\"first_name\", type text}, {\"last_name\", type text}, {\"email\", type text}, {\"gender\", type text}, {\"birth_date\", type text}, {\"age_band\", type text}, {\"city\", type text}, {\"country\", type text}, {\"signup_date\", type date}, {\"acquisition_channel\", type text}, {\"is_loyalty_member\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
