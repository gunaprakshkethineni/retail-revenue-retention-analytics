      {
        "name": "fact_orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "int64",
            "sourceColumn": "order_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "store_id",
            "dataType": "int64",
            "sourceColumn": "store_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "payment_method",
            "dataType": "string",
            "sourceColumn": "payment_method",
            "summarizeBy": "none"
          },
          {
            "name": "shipping_cost",
            "dataType": "double",
            "sourceColumn": "shipping_cost",
            "summarizeBy": "none"
          },
          {
            "name": "n_items",
            "dataType": "int64",
            "sourceColumn": "n_items",
            "summarizeBy": "none"
          },
          {
            "name": "Month Index",
            "type": "calculated",
            "expression": [
              "VAR FirstOrder =",
              "    RELATED ( dim_customers[First Order Date] )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( FirstOrder ),",
              "        ( YEAR ( fact_orders[order_date] ) * 12 + MONTH ( fact_orders[order_date] ) )",
              "            - ( YEAR ( FirstOrder ) * 12 + MONTH ( FirstOrder ) )",
              "    )"
            ],
            "isDataTypeInferred": true,
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_orders.csv\"),[Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted,{{\"order_id\", Int64.Type}, {\"customer_id\", Int64.Type}, {\"store_id\", Int64.Type}, {\"order_date\", type date}, {\"order_status\", type text}, {\"payment_method\", type text}, {\"shipping_cost\", type number}, {\"n_items\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
